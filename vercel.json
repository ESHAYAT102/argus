{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__argus_path=health"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api?__argus_path=v1/:path*"
    }
  ]
}
